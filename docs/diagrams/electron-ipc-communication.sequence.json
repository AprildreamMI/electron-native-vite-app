  "cards": [
    {
      "dot": "cyan",
      "title": "注册位置",
      "items": [
        "electron/main.cjs:36 只调用一次 registerIpcHandlers(ipcMain)",
        "electron/ipc/index.cjs 聚合 user 与 demo 功能模块",
        "功能模块通过 ipcMain.on 或 ipcMain.handle 注册 channel"
      ]
    },
    {
      "dot": "rose",
      "title": "安全边界",
      "items": [
        "Vue 页面不直接导入 electron，只调用 src/apis 下的业务 API",
        "electron/preload.cjs 通过 contextBridge 暴露 window.mainApi",
        "send、invoke、Renderer listener 各自经过独立 channel 白名单"
      ]
    },
    {
      "dot": "emerald",
      "title": "方法对应关系",
      "items": [
        "send 对应 ipcRenderer.send + ipcMain.on，不等待返回",
        "invoke 对应 ipcRenderer.invoke + ipcMain.handle，返回 Promise",
        "on、once、off 管理 ipcRenderer listener；Main 用 event.sender.send 推送"
      ]
    }
  ]
