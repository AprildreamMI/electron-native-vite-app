  "meta": {
    "title": "Electron IPC 通信全链路",
    "subtitle": "从启动注册到 send、invoke、on、once、off 与 Main 主动推送",
    "output": "docs/diagrams/electron-ipc-communication.html",
    "viewBox": [820, 1680],
    "animation": "none",
    "visual_preset": "classic",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "startup-registration",
        "label": "启动时注册",
        "focus": ["main", "registry", "module", "ipc"],
        "note": "Main ready 后通过聚合入口，把功能模块的 on 与 handle 注册到 ipcMain。"
      },
      {
        "id": "renderer-request",
        "label": "Renderer 发起请求",
        "focus": ["view", "api", "bridge", "ipc", "module"],
        "note": "页面只调用业务 API，再由 Preload 白名单桥接到 Electron IPC。"
      },
      {
        "id": "main-push",
        "label": "Main 主动推送",
        "focus": ["module", "ipc", "bridge", "api", "view"],
        "note": "event.sender.send 触发 Renderer listener，业务包装层只向页面转交 payload。"
      },
      {
        "id": "listener-cleanup",
        "label": "监听与清理",
        "focus": ["view", "api", "bridge", "ipc"],
        "note": "on 与 once 在 ipcRenderer 注册；off 用订阅 ID 找回原 listener 并移除。"
      }
    ]
  },
